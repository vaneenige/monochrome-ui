#!/bin/sh
set -e

# Abort if package.json has unstaged edits: the build below rewrites
# versionMeta, and the subsequent `git add package.json` would sweep
# any unrelated working-tree changes into the commit. Force the dev
# to stash, commit, or revert them first.
if ! git diff --quiet -- package.json; then
  echo "pre-commit: package.json has unstaged changes. Stash, commit, or revert them before committing." >&2
  exit 1
fi

# Lint first so formatting / lint drift fails before the slower
# build + typecheck steps. `biome check` covers both lint and format.
bun run lint

# Build before typecheck: fixtures and tests resolve the package's
# own exports, so tsc checks against dist/*.d.ts and needs them
# regenerated from the current source first. Build also rewrites
# package.json's versionMeta. See AGENTS.md › Build pipeline.
bun run build

bun run typecheck

# Run the full Playwright suite. ~22s but catches regressions before
# they reach the branch; the library's accessibility guarantees are
# only as good as the tests that pin them.
bun run test

# Stage the build-touched package.json only after every gate has
# passed. If lint / typecheck / build / test had failed earlier, the
# rewrite stays in the working tree, not the index, so an aborted
# commit leaves no half-staged state behind.
git add package.json
