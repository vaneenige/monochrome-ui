{
  "compilerOptions": {
    // Environment Settings
    "module": "preserve",
    "target": "esnext",
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // The examples `add` prints import the parts from the project's
    // components folder; here that is the templates they are built from.
    "paths": {
      "@/components/ui": ["./tests/templates/react.ts"],
      "@/components/ui/*": ["./templates/react/*"]
    }
  }
}
