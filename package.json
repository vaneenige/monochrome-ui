{
  "name": "monochrome",
  "version": "0.16.0",
  "description": "Accessible UI component library. Best-in-class performance. HTML-first, React and Vue supported.",
  "author": "Colin van Eenige",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaneenige/monochrome-ui.git"
  },
  "homepage": "https://github.com/vaneenige/monochrome-ui#readme",
  "bugs": "https://github.com/vaneenige/monochrome-ui/issues",
  "keywords": [
    "accessible",
    "a11y",
    "aria",
    "wai-aria",
    "ui",
    "component",
    "components",
    "component-library",
    "library",
    "headless",
    "unstyled",
    "lightweight",
    "keyboard-navigation",
    "html",
    "react",
    "vue",
    "typescript",
    "accordion",
    "collapsible",
    "dialog",
    "menu",
    "menubar",
    "popover",
    "tabs",
    "tooltip"
  ],
  "packageManager": "bun@1.4.2",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/accordion.ts",
    "./src/collapsible.ts",
    "./src/dialog.ts",
    "./src/menu.ts",
    "./src/popover.ts",
    "./src/router.ts",
    "./src/tabs.ts",
    "./src/tooltip.ts",
    "./dist/index.js",
    "./dist/accordion.js",
    "./dist/collapsible.js",
    "./dist/dialog.js",
    "./dist/menu.js",
    "./dist/popover.js",
    "./dist/router.js",
    "./dist/tabs.js",
    "./dist/tooltip.js"
  ],
  "browserslist": {
    "core": [
      "chrome >= 114",
      "safari >= 17",
      "firefox >= 125"
    ],
    "router": [
      "chrome >= 135",
      "safari >= 26.2",
      "firefox >= 147"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "default": "./dist/accordion.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "default": "./dist/collapsible.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "default": "./dist/menu.js"
    },
    "./menubar": {
      "types": "./dist/menu.d.ts",
      "default": "./dist/menu.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "default": "./dist/popover.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "default": "./dist/tooltip.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_ENV=production bun build.ts",
    "test": "bun --bun playwright test --project=html --project=react --project=vue",
    "test:all": "bun --bun playwright test",
    "test:install": "bunx playwright install chromium",
    "test:install:all": "bunx playwright install chromium webkit firefox",
    "lint": "oxlint src tests scripts build.ts && oxfmt --check src tests scripts build.ts",
    "lint:fix": "oxlint --fix src tests scripts build.ts && oxfmt src tests scripts build.ts",
    "format": "oxfmt src tests scripts build.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "sh scripts/git-hooks/install",
    "prepublishOnly": "bun run lint && bun run build && bun run typecheck",
    "support": "bun scripts/support.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdn/browser-compat-data": "8.1.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/compiler-sfc": "3.5.42",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.7",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vue": "3.5.42"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  },
